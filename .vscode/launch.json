{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Order API (debug)",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "softcon-demo-order-api: func host start"
    }
  ]
}
